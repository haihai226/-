{
  "name": "openclaw-portable",
  "version": "0.2.0",
  "description": "OpenClaw portable launcher",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "prepare:runtime": "node scripts/prepare-openclaw-runtime.mjs",
    "dist:mac": "electron-builder --mac zip",
    "dist:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "ai.openclaw.portable",
    "productName": "OpenClaw Portable",
    "artifactName": "OpenClaw-Portable-${os}-${arch}-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
