# 复制为 .env 后填写。.env 已在 .gitignore 里，不要提交，也不要贴进聊天。

# ---- STT（语音识别）----
# 首选 FunASR 本地部署（不需要 key）；备选 deepgram / azure
STT_PROVIDER=funasr
STT_API_KEY=
STT_BASE_URL=ws://127.0.0.1:10095

# ---- TTS（语音合成）----
# 首选 minimax；备选 fish / azure
TTS_PROVIDER=minimax
TTS_API_KEY=
TTS_BASE_URL=
# MiniMax 需要 group id，其它供应商留空
TTS_GROUP_ID=
TTS_VOICE_ID=

# ---- LLM（快模型，OpenAI 兼容接口，非 thinking）----
# 例：Qwen3 走 DashScope 兼容模式，或 DeepSeek
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ---- DeepTutor ----
# API 只在内网；网页只绑 127.0.0.1
DEEPTUTOR_API_URL=http://127.0.0.1:8001
DEEPTUTOR_WEB_PORT=3782
DEEPTUTOR_API_PORT=8001
DEEPTUTOR_PARTNER=voice-tutor

# ---- voice-agent ----
VOICE_AGENT_HOST=127.0.0.1
VOICE_AGENT_PORT=7860
